{
  "name": "celer",
  "displayName": "Celer - C/C++ Package Manager",
  "description": "GUI plugin for Celer Package Manager",
  "version": "0.0.4",
  "publisher": "celer",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/celer-pkg/celer-vscode.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/{celer,Celer}.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "celer-sidebar",
          "title": "Celer",
          "icon": "resources/logo.png"
        }
      ]
    },
    "views": {
      "celer-sidebar": [
        {
          "id": "celer.sidebar",
          "name": "Packages",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "celer.sidebarRefresh",
          "when": "view == celer.sidebar",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "celer.init",
        "title": "Celer: Initialize Project",
        "icon": "$(rocket)"
      },
      {
        "command": "celer.install",
        "title": "Celer: Install Package",
        "icon": "$(cloud-download)"
      },
      {
        "command": "celer.remove",
        "title": "Celer: Remove Package",
        "icon": "$(trash)"
      },
      {
        "command": "celer.update",
        "title": "Celer: Update",
        "icon": "$(sync)"
      },
      {
        "command": "celer.search",
        "title": "Celer: Search Packages",
        "icon": "$(search)"
      },
      {
        "command": "celer.clean",
        "title": "Celer: Clean Build Cache",
        "icon": "$(clear-all)"
      },
      {
        "command": "celer.autoremove",
        "title": "Celer: Auto Remove Unused Libraries",
        "icon": "$(trash)"
      },
      {
        "command": "celer.tree",
        "title": "Celer: Show Dependency Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "celer.reverse",
        "title": "Celer: Show Reverse Dependencies",
        "icon": "$(references)"
      },
      {
        "command": "celer.deploy",
        "title": "Celer: Deploy Project",
        "icon": "$(rocket)"
      },
      {
        "command": "celer.create",
        "title": "Celer: Create Platform/Project/Port",
        "icon": "$(new-file)"
      },
      {
        "command": "celer.configure",
        "title": "Celer: Configure Global Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "celer.version",
        "title": "Celer: Show Version",
        "icon": "$(info)"
      },
      {
        "command": "celer.selectBuildType",
        "title": "Celer: Select Build Type"
      },
      {
        "command": "celer.toggleStatusBar",
        "title": "Celer: Toggle Status Bar Buttons",
        "icon": "$(menu)"
      },
      {
        "command": "celer.selectPlatform",
        "title": "Celer: Select Platform"
      },
      {
        "command": "celer.selectProject",
        "title": "Celer: Select Project"
      },
      {
        "command": "celer.selectJobs",
        "title": "Celer: Select Build Jobs"
      },
      {
        "command": "celer.installCelerExecutable",
        "title": "Celer: Download Celer Executable"
      },
      {
        "command": "celer.resetFirstRun",
        "title": "Celer: Reset First Run Status"
      },
      {
        "command": "celer.nfsClient",
        "title": "Celer: Setup NFS Client",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "celer.nfsServer",
        "title": "Celer: Setup NFS Server",
        "icon": "$(cloud-download)"
      },
      {
        "command": "celer.sidebarRefresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Celer",
      "properties": {
        "celer.executable": {
          "type": "string",
          "default": "celer",
          "description": "Path to the Celer executable"
        },
        "celer.autoInstall": {
          "type": "boolean",
          "default": false,
          "description": "Automatically install dependencies on project open"
        },
        "celer.checkUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check for package updates on startup"
        },
        "celer.statusBar.showVersion": {
          "type": "boolean",
          "default": true,
          "description": "Show version button on status bar"
        },
        "celer.statusBar.showConfigure": {
          "type": "boolean",
          "default": true,
          "description": "Show configure button on status bar"
        },
        "celer.statusBar.showPlatform": {
          "type": "boolean",
          "default": true,
          "description": "Show platform selector on status bar"
        },
        "celer.statusBar.showProject": {
          "type": "boolean",
          "default": true,
          "description": "Show project selector on status bar"
        },
        "celer.statusBar.showBuildType": {
          "type": "boolean",
          "default": true,
          "description": "Show build type selector on status bar"
        },
        "celer.statusBar.showJobs": {
          "type": "boolean",
          "default": true,
          "description": "Show jobs selector on status bar"
        },
        "celer.statusBar.showInit": {
          "type": "boolean",
          "default": true,
          "description": "Show init button on status bar"
        },
        "celer.statusBar.showCreate": {
          "type": "boolean",
          "default": true,
          "description": "Show create button on status bar"
        },
        "celer.statusBar.showInstall": {
          "type": "boolean",
          "default": true,
          "description": "Show install button on status bar"
        },
        "celer.statusBar.showUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Show update button on status bar"
        },
        "celer.statusBar.showSearch": {
          "type": "boolean",
          "default": true,
          "description": "Show search button on status bar"
        },
        "celer.statusBar.showClean": {
          "type": "boolean",
          "default": true,
          "description": "Show clean button on status bar"
        },
        "celer.statusBar.showAutoremove": {
          "type": "boolean",
          "default": true,
          "description": "Show autoremove button on status bar"
        },
        "celer.statusBar.showReverse": {
          "type": "boolean",
          "default": true,
          "description": "Show reverse button on status bar"
        },
        "celer.statusBar.showTree": {
          "type": "boolean",
          "default": true,
          "description": "Show tree button on status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node --no-deprecation esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node --no-deprecation esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node --no-deprecation esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "@ltd/j-toml": "^1.38.0"
  }
}
